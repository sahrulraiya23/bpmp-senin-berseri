# ==============================================================
# BPMP SENIN BERSERI - KONFIGURASI SUPABASE CLOUD DATABASE (DEFAULT)
# ==============================================================
# Dapatkan kredensial ini di dashboard Supabase:
# https://supabase.com/dashboard/project/_/settings/api

# Driver database aktif (default: supabase)
DB_DRIVER=supabase

# URL Proyek Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# Kunci API Supabase (disarankan menggunakan service_role key untuk backend Node.js)
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# ==============================================================
# OPSIONAL: DRIVER MYSQL
# ==============================================================
# DB_DRIVER=mysql
# DATABASE_URL=mysql://username:password@host.domain.com:3306/senin_berseri?ssl={"rejectUnauthorized":false}

# ==============================================================
# PENGATURAN SERVER & SESI
# ==============================================================
PORT=3000
ADMIN_PASSWORD=Bpmp2026!
SUPERADMIN_PASSWORD=Bpmp2026!
SESSION_SECRET=bpmp-senin-berseri-super-secret-key-2026
