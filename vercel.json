{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/sertifikat/:id", "destination": "/sertifikat.html" },
    { "source": "/sertifikat", "destination": "/sertifikat.html" },
    { "source": "/verify/:id", "destination": "/sertifikat.html" },
    { "source": "/login", "destination": "/pegawai.html" },
    { "source": "/pegawai", "destination": "/pegawai.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/admin/rekap-presensi", "destination": "/admin-rekap-presensi.html" },
    { "source": "/admin/verifikasi-lpti", "destination": "/admin-verifikasi-lpti.html" },
    { "source": "/admin/kegiatan", "destination": "/admin-kegiatan.html" },
    { "source": "/admin/audit-log", "destination": "/admin-audit-log.html" },
    { "source": "/admin/pegawai/:id", "destination": "/admin-pegawai-detail.html" },
    { "source": "/peserta/riwayat", "destination": "/peserta-riwayat.html" },
    { "source": "/peserta/kegiatan/:id", "destination": "/peserta-kegiatan-detail.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/superadmin", "destination": "/superadmin.html" },
    { "source": "/proyektor", "destination": "/proyektor.html" },
    { "source": "/qr", "destination": "/proyektor.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
