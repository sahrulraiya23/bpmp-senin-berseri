{
  "version": 2,
  "rewrites": [
    { "source": "/login", "destination": "/pegawai.html" },
    { "source": "/pegawai", "destination": "/pegawai.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/superadmin", "destination": "/superadmin.html" },
    { "source": "/proyektor", "destination": "/proyektor.html" },
    { "source": "/qr", "destination": "/proyektor.html" },
    { "source": "/verif-wajah", "destination": "/verif-wajah.html" },
    { "source": "/verifikasi-wajah", "destination": "/verif-wajah.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
